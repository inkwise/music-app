# 音乐服务配置文件
# 服务器端口
SERVER_PORT=8080

# 数据库类型: sqlite 或 mysql
DB_TYPE=sqlite
# SQLite 数据库文件路径
DB_PATH=./data/music.db
# MySQL 连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=music_service

# 存储类型: oss 或 local
STORAGE_TYPE=oss
# 本地存储目录
LOCAL_STORAGE_PATH=./uploads
# 阿里云 OSS 配置
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=your-bucket-name

# JWT 密钥
JWT_SECRET=my-super-secret-key-12345

# 音频指纹配置
FINGERPRINT_MAX_WORKERS=2
FINGERPRINT_MIN_SIMILARITY=0.85
FINGERPRINT_DURATION_TOLERANCE=10.0

# 初始化状态
MUSIC_SERVICE_INITIALIZED=false
